                            <div class="lesson lesson--purple"><br>АиП<br>805</div>
                        </div>
                    </td>
                    <td>
                        <div class="lesson-container">
                            <div class="lesson lesson--blue"><br>МА<br>224л</div>
                        </div>
                    </td>
                    <td>
